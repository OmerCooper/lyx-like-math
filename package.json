{
  "name": "obsidian-lyx-like-math",
  "version": "0.1.2",
  "description": "LyX-style WYSIWYG math editing for Obsidian",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "e2e": "node e2e/run.mjs && node e2e/session-run.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "mathlive": "0.111.1"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
